// Prisma schema for Starry Health (Oqata) — Multi-Tenant with Subscription Tiers
// Plans: STANDARD (5 products) | SMART (10 products) | PREMIUM (unlimited + all features)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  USER
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PENDING
  EXPIRED
  REFUSED
  SUSPENDED
}

enum SubscriptionPlan {
  STANDARD
  SMART
  PREMIUM
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY // 3 months
  SEMI_ANNUAL // 6 months
  ANNUAL // 1 year
}

enum UsernameChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminSuggestionStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                 Int                @id @default(autoincrement())
  name               String?
  email              String             @unique
  password           String?
  googleId           String?
  username           String?            @unique
  slug               String             @unique
  role               Role               @default(USER)
  subscriptionStatus SubscriptionStatus @default(FREE)
  subscriptionPlan   SubscriptionPlan? // Active plan tier (null = FREE)

  // Branding & Identity
  avatar       String?
  bio          String?
  primaryColor String  @default("#0f766e")

  // Contact
  contactPhone   String?
  contactEmail   String?
  whatsapp       String?
  contactAddress String?
  contactWebsite String?

  // Social links
  facebook  String?
  linkedin  String?
  tiktok    String?
  instagram String?

  // Custom copyright text
  copyright String?

  // UI Theme preference ("light", "dark", "system")
  theme String? @default("system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions          Subscription[]
  subscriptionHistory    SubscriptionHistory[]
  userProductPrices      UserProductPrice[]
  carouselItems          CarouselItem[]
  testimonials           Testimonial[]
  products               Product[] // User's own products
  partners               Partner[] // User's own partners
  services               Service[]
  faqs                   FAQ[]
  galleryImages          GalleryImage[]
  suggestions            Suggestion[] // Suggestions received by this user from visitors
  adminSuggestions       AdminSuggestion[] // Suggestions sent by this user to Starry Health admin
  usernameChangeRequests UsernameChangeRequest[]
  productCategories      ProductCategory[] // User's own product categories (PREMIUM)
  tenantConfig           TenantConfig?
  customDomain           CustomDomain?
}

// ─────────────────────────────────────────────
// TENANT CONFIG (1:1 with User)
// ─────────────────────────────────────────────

model TenantConfig {
  id               Int     @id @default(autoincrement())
  userId           Int     @unique
  orgName          String?
  orgDescription   String?
  orgLogo          String?
  favicon          String?
  secondaryColor   String?
  headerColor      String?
  accentColor      String?
  sidebarBgColor   String?
  sidebarTextColor String?
  footerColor      String?
  dashboardBgColor String?
  buttonColor      String?
  fontFamily       String? // e.g. "Inter", "Outfit", "Roboto"

  // Tenant lifecycle
  status          String    @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED, REJECTED
  validatedAt     DateTime?
  validatedBy     Int?
  rejectionReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SUBSCRIPTION PLAN CONFIG (Dynamic admin-managed plans)
// ─────────────────────────────────────────────

model SubscriptionPlanConfig {
  id              Int      @id @default(autoincrement())
  name            String   @unique // "STANDARD", "SMART", "PREMIUM", or custom
  displayName     String
  description     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  monthlyPrice    Float    @default(0)
  quarterlyPrice  Float?
  semiAnnualPrice Float?
  annualPrice     Float?
  features        Json     @default("[]") // Array of feature strings
  limits          Json     @default("{}") // { maxProducts: 5, hasGallery: false, ... }
  badge           String? // "Populaire", "Recommandé"
  color           String? // "#0ea5e9"
  icon            String? // "Shield", "Zap", "Crown"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────────

model Subscription {
  id             Int              @id @default(autoincrement())
  userId         Int
  plan           SubscriptionPlan @default(STANDARD)
  status         String           @default("PENDING") // PENDING, ACTIVE, EXPIRED, REFUSED, SUSPENDED
  durationMonths Int?             @default(1)
  requestedAt    DateTime?        @default(now())
  startDate      DateTime?
  expiresAt      DateTime?
  validatedAt    DateTime?
  validatedBy    Int?
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history SubscriptionHistory[]
}

// ─────────────────────────────────────────────
// SUBSCRIPTION HISTORY (Audit & timeline)
// ─────────────────────────────────────────────

model SubscriptionHistory {
  id             Int              @id @default(autoincrement())
  subscriptionId Int?
  userId         Int
  plan           SubscriptionPlan
  status         String
  action         String // "REQUESTED", "VALIDATED", "REFUSED", "ACTIVATED", "SUSPENDED", "EXTENDED", "MODIFIED", "EXPIRED"
  notes          String?
  performedBy    Int? // User ID of admin who performed action (null for self-request)
  startDate      DateTime?
  expiresAt      DateTime?
  durationMonths Int?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────
// SUBSCRIPTION PLAN PRICING
// ─────────────────────────────────────────────

model SubscriptionPlanPricing {
  id            Int              @id @default(autoincrement())
  plan          SubscriptionPlan
  billingPeriod BillingPeriod
  pricePerMonth Float // Price per month (displayed)
  totalBilled   Float // Total amount billed for the period

  @@unique([plan, billingPeriod])
}

// ─────────────────────────────────────────────
// PRODUCT CATEGORY (PREMIUM — parent/child hierarchy)
// ─────────────────────────────────────────────

model ProductCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String
  description String?
  parentId    Int?
  sortOrder   Int      @default(0)
  userId      Int? // null = global admin category
  createdAt   DateTime @default(now())

  parent   ProductCategory?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryChildren")
  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([slug, userId])
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  id               Int     @id @default(autoincrement())
  userId           Int? // null = global product (admin), set = user's own product
  name             String
  description      String
  shortDescription String?
  defaultPrice     Float
  originalPrice    Float? // Original price before discount (if set, shows strikethrough + %)
  images           String // Comma-separated URLs or JSON string array
  category         String  @default("Santé & Bien-être")
  categoryId       Int? // FK to ProductCategory (PREMIUM)
  isVisible        Boolean @default(true)

  // Advanced fields (PREMIUM)
  ingredients       String?  @db.Text
  benefits          String?  @db.Text
  usage             String?  @db.Text
  contraindications String?  @db.Text
  certifications    String[] @default([])
  origin            String?
  packaging         String?
  metaTitle         String?
  metaDescription   String?
  seoSlug           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productCat   ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userPrices   UserProductPrice[]
  testimonials Testimonial[]
}

// ─────────────────────────────────────────────
// USER PRODUCT PRICE (Custom pricing per tenant)
// ─────────────────────────────────────────────

model UserProductPrice {
  id          Int   @id @default(autoincrement())
  userId      Int
  productId   Int
  customPrice Float

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// SERVICE (Offers & custom links — SMART+)
// ─────────────────────────────────────────────

model Service {
  id     Int     @id @default(autoincrement())
  userId Int
  name   String
  url    String?
  order  Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// FAQ (PREMIUM)
// ─────────────────────────────────────────────

model FAQ {
  id       Int    @id @default(autoincrement())
  userId   Int
  question String
  answer   String
  order    Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// GALLERY IMAGE (PREMIUM)
// ─────────────────────────────────────────────

model GalleryImage {
  id       Int     @id @default(autoincrement())
  userId   Int
  imageUrl String
  caption  String?
  order    Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CAROUSEL ITEM
// ─────────────────────────────────────────────

model CarouselItem {
  id       Int     @id @default(autoincrement())
  userId   Int? // null = global/default carousel, set = user custom
  imageUrl String
  title    String
  subtitle String?
  link     String?
  order    Int     @default(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// TESTIMONIAL
// ─────────────────────────────────────────────

model Testimonial {
  id         Int     @id @default(autoincrement())
  userId     Int? // null = public global, set = user custom
  productId  Int?
  authorName String
  content    String
  rating     Int     @default(5)
  avatar     String?
  isPublic   Boolean @default(true)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────
// PARTNER
// ─────────────────────────────────────────────

model Partner {
  id      Int     @id @default(autoincrement())
  userId  Int? // null = global partner (admin), set = user's own partner
  name    String
  logoUrl String
  website String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SUGGESTION (Visitor suggestion box)
// ─────────────────────────────────────────────

model Suggestion {
  id         Int      @id @default(autoincrement())
  userId     Int? // Target user (tenant) who receives the suggestion
  authorName String?
  email      String?
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ADMIN SUGGESTION (Subscribers sending message to Starry Health Admin)
// ─────────────────────────────────────────────

model AdminSuggestion {
  id         Int                   @id @default(autoincrement())
  userId     Int // Sender subscriber
  subject    String
  message    String
  isRead     Boolean               @default(false)
  status     AdminSuggestionStatus @default(NEW)
  adminReply String?               @db.Text
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CUSTOM DOMAIN (PREMIUM)
// ─────────────────────────────────────────────

model CustomDomain {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  domain     String    @unique // e.g. "mysite.com"
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// USERNAME CHANGE REQUEST (Tenant change workflow)
// ─────────────────────────────────────────────

model UsernameChangeRequest {
  id          Int                  @id @default(autoincrement())
  userId      Int
  oldUsername String
  newUsername String
  status      UsernameChangeStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
