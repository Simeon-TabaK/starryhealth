// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  password     String
  slug         String         @unique
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  clientAccess ClientAccess[]
  profile      Profile?
  subscription Subscription?
}

model Profile {
  id          Int            @id @default(autoincrement())
  userId      Int            @unique
  contact     String?
  facebook    String?
  linkedin    String?
  instagram   String?
  tiktok      String?
  email       String?
  image       String?
  whatsapp    String?
  firstName   String
  lastName    String?
  middleName  String
  city        String?
  country     String?
  user        User           @relation(fields: [userId], references: [id])
  testimonies Testimony[]
  carousel    UserCarousel[]
  products    UserProduct[]
}

model SubscriptionPlan {
  id              Int            @id @default(autoincrement())
  name            String
  description     String?
  priceMonthly    Float
  priceQuarterly  Float?
  priceSemiAnnual Float?
  priceAnnual     Float?
  durationInDays  Int
  subscriptions   Subscription[]
}

model Subscription {
  id        Int              @id @default(autoincrement())
  userId    Int              @unique
  planId    Int
  duration  Duration
  startDate DateTime         @default(now())
  endDate   DateTime
  active    Boolean          @default(true)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
}

model Product {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?
  imageUrl     String?
  details      ProductDetails[]
  testimonies  Testimony[]
  userProducts UserProduct[]
}

model ProductDetails {
  id          Int     @id @default(autoincrement())
  name        String?
  description String?
  type        Type
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
}

model UserProduct {
  id        Int      @id @default(autoincrement())
  userId    Int
  price     Float?
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  user      Profile  @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model DefaultCarousel {
  id            Int            @id @default(autoincrement())
  title         String?
  imageUrl      String
  userCarousels UserCarousel[]
}

model UserCarousel {
  id        Int              @id @default(autoincrement())
  userId    Int
  defaultId Int?
  imageUrl  String
  visible   Boolean          @default(true)
  default   DefaultCarousel? @relation(fields: [defaultId], references: [id])
  user      Profile          @relation(fields: [userId], references: [id])
}

model Testimony {
  id        Int      @id @default(autoincrement())
  content   String
  public    Boolean  @default(false)
  validated Boolean  @default(false)
  createdAt DateTime @default(now())
  productId Int?
  profileId Int
  product   Product? @relation(fields: [productId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model ClientAccess {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  subdomain String?  @unique
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}

enum Duration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

enum Type {
  INTRO
  PROBLEM
  SOLUTION
  INGREDIENT
  BENEFIT
}
