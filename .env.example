# ─── Base de données PostgreSQL ────────────────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:VotrePassword@213.156.134.26:54287/postgres"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-ici"
NEXTAUTH_URL="https://votre-domaine.com"

# ─── Google OAuth (optionnel - pour connexion Google) ──────────────────────────
# Créer sur : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="votre-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre-google-client-secret"

# ─── Cloudinary (upload images produits) ───────────────────────────────────────
# Compte sur : https://cloudinary.com
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# ─── Domaines multi-tenant ─────────────────────────────────────────────────────
# Domaine principal de l'app (sans https://)
NEXT_PUBLIC_MAIN_DOMAIN="votre-domaine.com"
# Domaine racine pour la résolution tenant
ROOT_DOMAIN="votre-domaine.com"
# Domaines supplémentaires séparés par des virgules (optionnel)
ROOT_DOMAINS="votre-domaine.com,www.votre-domaine.com"
